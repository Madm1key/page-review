<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <param name="plugin-icon">images/pluginIcon.png</param>
        <param name="plugin-logo">images/pluginLogo.png</param>
    </plugin-info>

    <resource type="i18n" name="i18n" location="page-review"/>

    <web-item key="page-review-space-tools" name="GitLab repository settings" section="system.space.tools/addons" weight="250">
        <label key="page-review.settings.menu"/>
        <link linkId="page-review-settings">/plugins/page-review/settings.action?key=$space.key</link>
        <condition class="com.atlassian.confluence.plugin.descriptor.web.conditions.SpacePermissionCondition">
            <param name="permission">administer</param>
        </condition>
    </web-item>

    <xwork key="page-review-actions" name="GitLab repository settings actions">
        <package name="page-review" extends="default" namespace="/plugins/page-review">
            <default-interceptor-ref name="validatingStack"/>

            <action name="settings" class="ru.mts.confluence.web.SpaceSettingsAction" method="doDefault">
                <external-ref name="spaceSettingsService">spaceSettingsService</external-ref>
                <result name="input" type="velocity">/templates/page-review/space-settings.vm</result>
                <result name="success" type="velocity">/templates/page-review/space-settings.vm</result>
            </action>

            <action name="save" class="ru.mts.confluence.web.SpaceSettingsAction" method="doSave">
                <external-ref name="spaceSettingsService">spaceSettingsService</external-ref>
                <result name="input" type="velocity">/templates/page-review/space-settings.vm</result>
                <result name="success" type="velocity">/templates/page-review/space-settings.vm</result>
            </action>

            <action name="validate" class="ru.mts.confluence.web.SpaceSettingsAction" method="doValidate">
                <external-ref name="spaceSettingsService">spaceSettingsService</external-ref>
                <result name="success" type="velocity">/templates/page-review/space-settings.vm</result>
            </action>
        </package>
    </xwork>
</atlassian-plugin>
