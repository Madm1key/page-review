<html>
<head>
    <meta name="decorator" content="main"/>
    <title>$action.getText("page-review.settings.title")</title>
</head>
<body>
#applyDecorator("root")
    #decoratorParam("helper" $action.helper)
    #decoratorParam("context" "space-administration")
    #decoratorParam("mode" "view-space-administration")

    #applyDecorator("root")
        #decoratorParam("context" "spaceadminpanel")
        #decoratorParam("selection" "page-review-space-tools")
        #decoratorParam("title" $action.getText("page-review.settings.title"))
        #decoratorParam("selectedTab" "admin")
        #decoratorParam("helper" $action.helper)
        #decoratorParam("selectedSpaceToolsWebItem" "page-review-space-tools")

        <form class="aui" id="page-review-settings-form" action="save.action" method="post">
            #form_xsrfToken()
            <input type="hidden" name="key" value="$htmlUtil.htmlEncode($key)"/>

            #if ($action.saved)
                <div class="aui-message aui-message-success"><p>$action.getText("page-review.settings.saved")</p></div>
            #end
            #if ($action.checked)
                #if ($action.checkOk)
                    <div class="aui-message aui-message-success"><p>$htmlUtil.htmlEncode($action.checkMessage)</p></div>
                #else
                    <div class="aui-message aui-message-error"><p>$htmlUtil.htmlEncode($action.checkMessage)</p></div>
                #end
            #end

            <h2>$action.getText("page-review.settings.title")</h2>
            <p class="description">$action.getText("page-review.settings.intro")</p>

            <div class="field-group">
                <label for="pr-repoUrl">$action.getText("page-review.settings.repo")</label>
                <input class="text long-field" type="text" id="pr-repoUrl" name="repoUrl" value="$htmlUtil.htmlEncode($!action.repoUrl)" placeholder="https://gitlab.example.com/group/repo"/>
                #foreach ($err in $action.getFieldErrors().get("repoUrl"))<div class="error">$htmlUtil.htmlEncode($err)</div>#end
                <div class="description">$action.getText("page-review.settings.repo.hint")</div>
            </div>

            <div class="field-group">
                <label for="pr-targetBranch">$action.getText("page-review.settings.branch")</label>
                <input class="text medium-field" type="text" id="pr-targetBranch" name="targetBranch" value="$htmlUtil.htmlEncode($!action.targetBranch)"/>
                #foreach ($err in $action.getFieldErrors().get("targetBranch"))<div class="error">$htmlUtil.htmlEncode($err)</div>#end
                <div class="description">$action.getText("page-review.settings.branch.hint")</div>
            </div>

            <div class="field-group">
                <label for="pr-token">$action.getText("page-review.settings.token")</label>
                <input class="text long-field" type="password" id="pr-token" name="token" value="" autocomplete="new-password"
                       placeholder="#if ($action.tokenSet)$action.getText('page-review.settings.token.set')#end"/>
                #foreach ($err in $action.getFieldErrors().get("token"))<div class="error">$htmlUtil.htmlEncode($err)</div>#end
                <div class="description">$action.getText("page-review.settings.token.hint")</div>
            </div>

            <div class="buttons-container">
                <div class="buttons">
                    <input class="aui-button aui-button-primary" type="submit" value="$action.getText('page-review.settings.save')"/>
                    <input class="aui-button" type="submit" formaction="validate.action" value="$action.getText('page-review.settings.check')"/>
                </div>
            </div>
        </form>
    #end
#end
</body>
</html>
